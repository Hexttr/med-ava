# API-ключ Gemini (обязательно)
# Получить: https://ai.google.dev/
GEMINI_API_KEY=AIza...

# Прокси для запросов к Google (при использовании VPN или в регионах с ограничениями)
# Локально: SOCKS5 или HTTP
# EAM_HTTPS_PROXY=socks5://127.0.0.1:10808
# EAM_HTTPS_PROXY=http://127.0.0.1:10809

# На VPS в регионе без ограничений: можно не задавать или оставить пустым
# EAM_HTTPS_PROXY=

# Пароль для входа в приложение (форма авторизации)
# Если задан — все страницы требуют вход через /login
EAM_PASSWORD=513277

# HTTPS: установите true, если приложение доступно по HTTPS (для Secure cookies)
# При доступе по HTTP оставьте пустым или false
# EAM_HTTPS=true

# Публичный URL приложения (обязательно при self-hosted: редиректы иначе идут на localhost)
# EAM_PUBLIC_URL=http://81.31.245.65:3000
